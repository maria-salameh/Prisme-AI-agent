{
  "openapi": "3.0.3",
  "info": {
    "title": "API de l'assistant Prisme",
    "version": "1.0.0"
  },
  "paths": {
    "/api/chat": {
      "post": {
        "summary": "Envoie un message à l'assistant et reçoit sa réponse",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string", "minLength": 1, "maxLength": 235 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "La réponse de l'assistant",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "reply": { "type": "string" } }
                }
              }
            }
          },
          "400": { "description": "Message vide, trop long, absent ou corps illisible" },
          "405": { "description": "Méthode autre que POST" }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Indique que le serveur répond",
        "responses": {
          "200": {
            "description": "Le serveur est en bonne santé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
